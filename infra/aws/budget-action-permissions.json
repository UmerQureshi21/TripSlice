{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "OnlyAttachTheDenyPolicyToTheAppUser",
      "Effect": "Allow",
      "Action": [
        "iam:AttachUserPolicy",
        "iam:DetachUserPolicy"
      ],
      "Resource": "arn:aws:iam::660888594404:user/tripslice-backend",
      "Condition": {
        "ArnEquals": {
          "iam:PolicyARN": "arn:aws:iam::660888594404:policy/tripslice-emergency-deny"
        }
      }
    }
  ]
}
