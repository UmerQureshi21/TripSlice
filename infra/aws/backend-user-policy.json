{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "TripSliceVideosAndMontagesOnly",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject"],
      "Resource": [
        "arn:aws:s3:::tidier/videos/*",
        "arn:aws:s3:::tidier/montages/*",
        "arn:aws:s3:::tidier/test/*"
      ]
    }
  ]
}
